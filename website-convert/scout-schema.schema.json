{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Unique identifier of the template" },
          "inheritsFrom": { "type": "string", "description": "ID of the template this one extends" },
          "navigation": {
            "type": "object",
            "properties": {
              "description": { "type": "string", "description": "Human-readable explanation of the navigation block" },
              "links": { "type": "array", "description": "Navigation links defined by this template" }
            }
          },
          "footer": {
            "type": "object",
            "properties": {
              "description": { "type": "string", "description": "Human-readable explanation of the footer block" },
              "links": { "type": "array", "description": "Footer links defined by this template" }
            }
          },
          "otherElements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": { "type": "string", "description": "Description of this other template element" }
              }
            }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string", "description": "File path of the page" },
          "templateId": { "type": "string", "description": "ID of the template this page uses" },
          "title": { "type": "string", "description": "Page title" },
          "url": { "type": "string", "description": "Published URL of the page" },
          "collections": {
            "type": "array",
            "items": { "type": "string", "description": "ID of a collection this page draws from" }
          }
        }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Unique identifier of the collection" },
          "description": { "type": "string", "description": "Human-readable description of the collection" },
          "props": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "description": "Property name" },
                "type": {
                  "type": "string",
                  "description": "Data type of the property, matching a Sveltia CMS field type",
                  "enum": [
                    "boolean",
                    "code",
                    "color",
                    "compute",
                    "datetime",
                    "file",
                    "hidden",
                    "image",
                    "keyvalue",
                    "list",
                    "map",
                    "markdown",
                    "number",
                    "object",
                    "relation",
                    "richtext",
                    "select",
                    "string",
                    "text",
                    "uuid"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
